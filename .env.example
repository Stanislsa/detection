# ── SentinelAI — configuration exemple ──────────────────────
# Copier vers .env :  cp .env.example .env

# Sécurité (OBLIGATOIRE en prod — chaîne longue aléatoire)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Environnement: development | staging | production
ENVIRONMENT=development
DEBUG=true

# Base de données
DATABASE_URL=sqlite:///data/db/sentinel_ai.db

# Backend (frontend lit BACKEND_URL)
BACKEND_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# Alertes Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (simulation terminal si vide)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# IA / modèles
YOLO_MODEL_PATH=yolov8n.pt
MEDIAPIPE_COMPLEXITY=1
OPENVINO_DEVICE=CPU
ONNX_MODEL_PATH=

# Caméras RTSP (exemple LAN)
# RTSP_URL=rtsp://user:pass@192.168.1.50:554/stream1

# Observabilité
LOG_LEVEL=INFO
